# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 训练产物（体积大，可重新生成）
runs/
*.log
data/train.log

# 原始数据与中间产物（不纳入版本库）
data/coco/
*.zip

# 【提交方式变更：FTP -> GitHub 链接】
# 原来 data/images 和 data/annotations 是不入库的（当时靠 FTP 传 zip 包，
# 图片和标注在包外单独拷贝，仓库只放代码）。
# 现在改为提交 GitHub 链接，**仓库本身就是交付物**：
# 评委 clone 下来必须能直接 python app.py 看到 150 张图和已完成的标注，
# 否则打开是空界面，无法核验 60 条修正。所以这两个目录必须入库。
# 代价约 12 MB（11M 图片 + 1.2M 标注），对 Git 仓库完全可接受。
# 仍然排除：data/coco/（186MB 原始下载，可由 tools/prepare_data.py 重新生成）
# 和各类中间备份目录（annotations_r1_backup / annotations_r2 /
# annotations_before_shape_fix，属于过程产物，对比结论已汇总进
# records/对比结果.csv）。

# 预训练权重（从官方下载，不入库）
weights/
*.pt.tmp

# 但自训权重必须提交，所以单独放行
!model/best.pt

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 截图用的浏览器临时 profile
.edge_tmp/

# 评估中间产物（可由 tools/ 脚本重新生成）
data/annotations_r1_backup/
data/annotations_r2/
# draft_quality.json / round_compare.json 要保持入库：
# records/对比结果.csv 就是由 round_compare.json 生成的，
# 评委想复现对比表需要它（体积仅几 KB）。

# ultralytics 生成的标签缓存（可重新生成）
dataset/labels/*.cache

# 截图调试用的第二个 profile
.edge_tmp*/
demo_script.js

# UI 测试临时 harness（由 tools/ui_test.js 自动生成和清理）
canvas/_ui_harness.html
# 端到端上传测试自己生成、跑完自动删的临时文件
canvas/_e2e_harness.html
canvas/_e2e_src.jpg
canvas/_e2e_src.png

# 临时备份（体积大，可由tools/rerun_r1.py 重新生成）
data/annotations_before_shape_fix/
data/annotations_*/
data/train.log
canvas/_undoharness.html
canvas/_polyharness.html

# 训练/评估用的临时 yaml（path 为绝对路径，不入库）
dataset/_train.yaml
dataset/_eval.yaml

# 删除照片的回收站：软删除把「图片 + 标注」搬到这里，属于运行期数据。
# 用户自己删哪张图不该进版本库，恢复靠界面上的「恢复」按钮。
data/_trash/

# 单图诊断脚本生成的对比图（tools/diag_one_image.py 等，运行期产物）
data/_diag/

# 截图脚本往 canvas/ 写的临时注入脚本（由 tools/shoot_*.py 生成，用完即删）。
# 残留会让 ?uitest=1 的页面自动加载它们，干扰 UI 自动化测试。
canvas/demo_script.js
canvas/stroke_script.js
canvas/polyhint_script.js

# 本机试机时传进来的私人照片：不入库。
# 入库的 150 张是 COCO 公开图，文档里的指标（检测 0.728 / 掩码 0.580）
# 全部基于那 150 张；把这些图提交进来会让"别人 clone 下来复现"的口径变掉。
# 本地留着是为了演示上传/预标注链路，不影响仓库内容。
data/images/1.jpg
data/images/2.jpg
data/images/3.jpg
data/images/IMG_8072.webp
data/images/IMG_8073.webp
data/images/IMG_8073_2.webp
data/annotations/1.json
data/annotations/2.json
data/annotations/3.json
data/annotations/IMG_8072.json
data/annotations/IMG_8073.json
data/annotations/IMG_8073_2.json

# 手动备份目录（排查事故用，确认无碍后删）
data/_bak_ann_*/

# 导出时把「上次有、这次没有」的残留挪到这里（不删，见 exporter.py 注释）
dataset/_stale/

# 未审核的草稿标注（新上传的图还没人工过一遍，不该进训练集）
data/_unreviewed/

# 训练前自动备份的旧权重（每份 6~7 MB，只留最近 3 份，不进库）
model/_backup/

# 训练进度用的运行时文件（pid 与启动时刻，本机有效，换机器无意义）
data/train_meta.json

# Cloudflare 隧道工具（52 MB 的单文件二进制，不进版本库）
# 换机器时从 https://github.com/cloudflare/cloudflared/releases 下 windows-amd64
tools/cloudflared.exe

# 隧道每次启动生成的二维码图与当时地址（一次性，换机器/换网络就没意义）
外网二维码.png
手机外网二维码.png
data/tunnel_url.txt
data/phone_url.txt
data/_ssh_known_hosts

# 自主学习的运行时状态：开关/第几代/上次结果 + 锁 + 过程日志 + 本代评估明细
# （records/自主学习记录.csv 不进这里——那是给人看的账，要跟着仓库走）
data/autolearn.json
data/autolearn.log
data/autolearn.lock
data/autolearn_eval.json
model/_cand/

# 跑界面测试时 Edge 的临时 profile（12 MB，每次自动重建）
demo/_probe/

# 换类/大批量改标注前的临时备份（一次性，别进仓库）
data/_anno_backup_*/
data/classes_backup_*.json
data/swap_metrics.json
